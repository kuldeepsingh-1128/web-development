<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>post in details</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2>here is the post details</h2>
    <p class="posts">id:-<%=post.id%></p>
    <div class="posts">
        <h2 class="user">@<%=post.username%></h2>
        <h3 class="content"><%=post.content%></h3>
        <br><br>
        <a href="http://localhost:8080/posts">return to all posts</a>
    </div>
</body>
</html>