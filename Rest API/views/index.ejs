<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <h1>Quora posts</h1>
  <hr>
  <%for(post of posts){%>
    <div class="posts">
      <h3 class="user">@<%=post.username%>
      <h4 class="content">
        <%=post.content%>
      </h4>
      <a href="http://localhost:8080/posts/<%=post.id%>">see more..</a>
      <hr>
    </div>
    
    <%}%>

      <br>
      <br>
      <br><br><br><br><br><br><br><br><br>
      <a href="http://localhost:8080/posts/new">Create new post</a>
</body>

</html>