<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="border">
        <br><br>
        <h3>Edit your chat..</h3>
        <p>From:-<%=Chat.from%> &ensp;&ensp;&emsp; To:-<%=Chat.to%>
        </p>
        <form action="/chats/<%=Chat._id%>?_method=PUT" method="post">
            <textarea name="msj" placeholder="enter your msj.." cols="42" rows="5"><%=Chat.msj%></textarea>
            <br><br>
            <button>submit</button>
            <br><br>
        </form>
    </div>
</body>

</html>